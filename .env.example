# Supabase — cross-device sync
#
# Without these two values the app still works fully; it just falls back to
# localStorage + BroadcastChannel, which only syncs tabs on the SAME device.
# The header shows "Live • this device only" when these are missing.
#
# Where to find them: Supabase dashboard -> your project -> Settings -> API
#   Project URL  -> VITE_SUPABASE_URL
#   anon / public key -> VITE_SUPABASE_ANON_KEY
#
# The anon key is designed to be public and is safe to ship in a browser bundle.
# Access is controlled by Row Level Security, not by hiding this key.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
